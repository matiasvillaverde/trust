+struct NoopBroker;
+
+impl Broker for NoopBroker {
+    fn kind(&self) -> BrokerKind {
+        BrokerKind::Alpaca
+    }
+
+    fn submit_trade(
+        &self,
+        _trade: &Trade,
+        _account: &Account,
+    ) -> Result<(BrokerLog, OrderIds), Box<dyn Error>> {
+        Ok((
+            BrokerLog::default(),
+            OrderIds {
+                stop: "stop".to_string(),
+                entry: "entry".to_string(),
+                target: "target".to_string(),
+            },
+        ))
+    }
+
+    fn sync_trade(
+        &self,
+        _trade: &Trade,
+        _account: &Account,
+    ) -> Result<(Status, Vec<Order>, BrokerLog), Box<dyn Error>> {
+        Ok((Status::Submitted, Vec::new(), BrokerLog::default()))
+    }
+
+    fn close_trade(
+        &self,
+        trade: &Trade,
+        _account: &Account,
+    ) -> Result<(Order, BrokerLog), Box<dyn Error>> {
+        Ok((trade.target.clone(), BrokerLog::default()))
+    }
+
+    fn cancel_trade(&self, _trade: &Trade, _account: &Account) -> Result<(), Box<dyn Error>> {
+        Ok(())
+    }
+
+    fn modify_stop(
+        &self,
+        _trade: &Trade,
+        _account: &Account,
+        _new_stop_price: Decimal,
+    ) -> Result<String, Box<dyn Error>> {
+        Ok("stop".to_string())
+    }
+
+    fn modify_target(
+        &self,
+        _trade: &Trade,
+        _account: &Account,
+        _new_price: Decimal,
+    ) -> Result<String, Box<dyn Error>> {
+        Ok("target".to_string())
+    }
+}
+
+
+fn seed(facade: &mut TrustFacade, side: TradeCategory) -> (Account, Trade) {
+    let account = facade.create_account("audit", "audit", Environment::Paper, dec!(0), dec!(0)).unwrap();
+    facade.create_transaction(&account, &TransactionCategory::Deposit, dec!(10000), &Currency::USD).unwrap();
+    let vehicle = facade.create_trading_vehicle("AUDIT", None, &TradingVehicleCategory::Stock, "ibkr").unwrap();
+    let (stop, target) = if side == TradeCategory::Long { (dec!(90), dec!(120)) } else { (dec!(110), dec!(80)) };
+    let trade = facade.create_trade(DraftTrade { account: account.clone(), trading_vehicle: vehicle, quantity: dec!(10), currency: Currency::USD, category: side, thesis: None, sector: None, asset_class: None, context: None }, stop, dec!(100), target).unwrap();
+    (account, trade)
+}
+fn facade() -> TrustFacade { TrustFacade::new(Box::new(SqliteDatabase::new_in_memory()), Box::new(NoopBroker)) }
+
+#[test]
+fn audit_short_profit_is_inverted() {
+    let mut f=facade(); let (account,t)=seed(&mut f, TradeCategory::Short);
+    let (mut funded,_,_,_)=f.fund_trade(&t).unwrap();
+    funded.entry.average_filled_price=Some(dec!(100));
+    let (mut filled,_)=f.fill_trade(&funded,dec!(0)).unwrap();
+    filled.target.average_filled_price=Some(dec!(80));
+    f.target_acquired(&filled,dec!(0)).unwrap();
+    let closed=f.read_trade(t.id).unwrap();
+    let balance=f.search_balance(account.id,&Currency::USD).unwrap();
+    println!("short sell 10 at 100 buy back at 80: pnl={}, account={}",closed.balance.total_performance,balance.total_available);
+    assert_eq!(closed.balance.total_performance,dec!(-200));
+    assert_eq!(balance.total_available,dec!(9800));
+}
+#[test]
+fn audit_stale_fill_replays() {
+    let mut f=facade(); let (account,t)=seed(&mut f,TradeCategory::Long);
+    let (mut funded,_,_,_)=f.fund_trade(&t).unwrap(); funded.entry.average_filled_price=Some(dec!(100));
+    f.fill_trade(&funded,dec!(0)).unwrap();
+    let replay=f.fill_trade(&funded,dec!(0));
+    assert!(replay.is_ok());
+    let persisted=f.read_trade(t.id).unwrap();
+    let balance=f.search_balance(account.id,&Currency::USD).unwrap();
+    println!("stale fill replay accepted: capital_in_market={}, account balance={}",persisted.balance.capital_in_market,balance.total_balance);
+    assert_eq!(persisted.balance.capital_in_market,dec!(2000));
+
+}
+#[test]
+fn audit_transfer_overspends_and_leaves_projection_stale() {
+    let mut f=facade(); let (account,_)=seed(&mut f,TradeCategory::Long);
+    let child=f.create_account_with_hierarchy("child","audit",Environment::Paper,dec!(0),dec!(0),model::AccountType::Earnings,Some(account.id)).unwrap();
+    f.transfer_between_accounts(account.id,child.id,dec!(15000),Currency::USD,"audit").unwrap();
+    let balance=f.search_balance(account.id,&Currency::USD).unwrap();
+    println!("transferred 15000 from 10000 account; cached available={}",balance.total_available);
+    assert_eq!(balance.total_available,dec!(10000));
+}
+#[test]
+fn audit_funding_failure_leaves_funded_status() {
+    use diesel::{Connection,RunQueryDsl};
+    let path=std::env::temp_dir().join(format!("trust-audit-{}.db",uuid::Uuid::new_v4()));
+    let url=path.to_str().unwrap();
+    let mut f=TrustFacade::new(Box::new(SqliteDatabase::new(url)),Box::new(NoopBroker));
+    let (_,t)=seed(&mut f,TradeCategory::Long);
+    let mut conn=diesel::SqliteConnection::establish(url).unwrap();
+    diesel::sql_query("CREATE TRIGGER audit_fail_funding BEFORE INSERT ON transactions WHEN NEW.category = 'fund_trade' BEGIN SELECT RAISE(ABORT, 'audit injected failure'); END").execute(&mut conn).unwrap();
+    assert!(f.fund_trade(&t).is_err());
+    let persisted=f.read_trade(t.id).unwrap();
+    println!("failed funding status={}, funded amount={}",persisted.status,persisted.balance.funding);
+    assert_eq!(persisted.status,Status::Funded); assert_eq!(persisted.balance.funding,dec!(0));
+}
+#[test]
+fn audit_short_funding_ignores_rule_read_failure() {
+    use diesel::{Connection,RunQueryDsl};
+    let path=std::env::temp_dir().join(format!("trust-audit-{}.db",uuid::Uuid::new_v4()));
+    let url=path.to_str().unwrap();
+    let mut f=TrustFacade::new(Box::new(SqliteDatabase::new(url)),Box::new(NoopBroker));
+    let (account,t)=seed(&mut f,TradeCategory::Short);
+    f.create_rule(&account,&model::RuleName::RiskPerTrade(0.01),"tight cap",&model::RuleLevel::Error).unwrap();
+    assert!(f.fund_trade(&t).is_err());
+    let mut conn=diesel::SqliteConnection::establish(url).unwrap();
+    diesel::sql_query("DROP TABLE rules").execute(&mut conn).unwrap();
+    assert!(f.fund_trade(&t).is_ok());
+    println!("short funding rejected with configured cap, accepted after rules became unreadable");
+}
