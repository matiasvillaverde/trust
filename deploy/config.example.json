{
  "listen": "0.0.0.0:8000",
  "public_url": "https://trust.example.com",
  "issuer": "https://identity.example.com/realms/trust",
  "jwks_file": "/etc/trust/jwks.json",
  "database": "/data/financial.db",
  "journal": "/data/control.db",
  "storage_encryption": {
    "financial_key_file": "/run/trust-secrets/financial-key.hex",
    "journal_key_file": "/run/trust-secrets/journal-key.hex",
    "backup_key_file": "/run/trust-secrets/backup-key.hex"
  },
  "allow_live": false,
  "reconcile_interval_seconds": 30,
  "max_token_lifetime_seconds": 3600,
  "owner_authentication": {
    "acr_values": ["urn:trust:owner:mfa"],
    "max_age_seconds": 300
  },
  "queue_capacity": 64,
  "request_timeout_ms": 45000,
  "queue_timeout_ms": 40000,
  "allowed_origins": [],
  "revoked_token_ids": [],
  "grants": {
    "REPLACE_WITH_OWNER_SUBJECT": {
      "role": "owner",
      "all_accounts": true,
      "scopes": ["trust:read", "trust:preview", "trust:trade", "trust:reconcile", "trust:manual", "trust:journal", "trust:policy", "trust:admin"],
      "allow_live": false
    },
    "REPLACE_WITH_MONITORING_SUBJECT": {
      "role": "agent",
      "all_accounts": true,
      "scopes": ["trust:observe"],
      "allow_live": false
    },
    "REPLACE_WITH_AGENT_SUBJECT": {
      "role": "agent",
      "accounts": ["00000000-0000-0000-0000-000000000001"],
      "scopes": ["trust:read", "trust:preview", "trust:trade", "trust:reconcile", "trust:journal"],
      "allow_live": false
    }
  }
}
