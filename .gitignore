# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Ignore all database files
db-sqlite/*.db
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# Python caches from workflow validation
__pycache__/
*.py[cod]

# Diesel migrations are source files, even on machines with global *.sql ignores.
!db-sqlite/migrations/**/*.sql
!service/migrations/**/*.sql

# Ignore all environmental files
.env

# Act configuration (local GitHub Actions runner)
.actrc

# Local caches
.cache_alpaca_docs/
.cache_apca/

# Local scratch/backup worktrees
trust-wt-db-backup/

# Service deployment secrets and local data
/deploy/config.local.json
/deploy/jwks.json
/deploy/secrets/
/.local/
/output/playwright/
*-key.hex
